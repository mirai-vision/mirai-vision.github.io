{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="publications-controls">
    <div class="publications-view-toggle" aria-label="Publication filter">
      <button type="button" class="publications-view-link" data-publication-view="all">all</button>
      <button type="button" class="publications-view-link active" data-publication-view="selected">selected</button>
      <button type="button" class="publications-view-link" data-publication-view="conferences">conferences</button>
      <button type="button" class="publications-view-link" data-publication-view="journals">journals</button>
    </div>
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="Type to filter"
    >
  </div>
{% endif %}
