<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    {% if include.limit %}
      <div
        class="table-responsive"
        {% if site.announcements.scrollable and news_size > 3 %}
          style="max-height: 60vw"
        {% endif %}
      >
        <table class="table table-sm table-borderless">
          {% for item in news limit: news_limit %}
            <tr>
              <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
    {% else %}
      {% assign current_year = '' %}
      {% for item in news limit: news_limit %}
        {% assign item_year = item.date | date: '%Y' %}
        {% if item_year != current_year %}
          {% assign current_year = item_year %}
          <h2 class="bibliography news-year-heading">{{ current_year }}</h2>
          <div class="table-responsive">
            <table class="table table-sm table-borderless">
        {% endif %}
              <tr>
                <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
        {% assign next_item = news[forloop.index] %}
        {% assign next_year = next_item.date | date: '%Y' %}
        {% if forloop.last or next_year != current_year %}
            </table>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
