---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header people-page-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% assign people_data_key = page.people_data_key | default: 'directory_sections' %}
    {% assign people_sections = page.directory_sections | default: site.data.people[people_data_key] %}
    {% assign people_alumni_link = page.alumni_link | default: site.data.people.alumni_link %}
    {% assign people_alumni_link_label = page.alumni_link_label | default: 'View alumni' %}
    {% if people_alumni_link %}
      <p class="people-alumni-link">
        <a href="{{ people_alumni_link | relative_url }}">{{ people_alumni_link_label }}</a>
      </p>
    {% endif %}
  </header>

  <article>
    {% if people_sections %}
      <div class="people-directory">
        {% for section in people_sections %}
          <section class="people-section">
            <h2 class="people-section-title">{{ section.title }}</h2>

            <div class="people-grid">
              {% for member in section.members %}
                <div class="people-card">
                  {% if member.image %}
                    {% assign member_image_path = member.image | prepend: 'assets/img/' %}
                    {% if member.url %}
                      <a class="people-card-link" href="{{ member.url }}" target="_blank" rel="noopener noreferrer">
                        {%
                          include figure.liquid
                          loading="eager"
                          path=member_image_path
                          class="people-card-image rounded-circle"
                          alt=member.name
                        %}
                      </a>
                    {% else %}
                      {%
                        include figure.liquid
                        loading="eager"
                        path=member_image_path
                        class="people-card-image rounded-circle"
                        alt=member.name
                      %}
                    {% endif %}
                  {% endif %}

                  {% if member.url %}
                    <a class="people-card-link people-card-name" href="{{ member.url }}" target="_blank" rel="noopener noreferrer">
                      {{ member.name }}
                    </a>
                  {% else %}
                    <div class="people-card-name">{{ member.name }}</div>
                  {% endif %}
                  <div class="people-card-role">{{ member.role }}</div>
                  {% if member.tenure %}
                    <div class="people-card-tenure">{{ member.tenure }}</div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </section>
        {% endfor %}
      </div>
    {% elsif content != blank %}
      <div class="people-directory">
        {{ content }}
      </div>
    {% elsif page.profiles %}
      {% for profile in page.profiles %}
        <hr>
        <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if profile.image %}
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% if profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
          {% endif %}
          {% if profile.more_info %}
            <div class="more-info">{{ profile.more_info }}</div>
          {% endif %}
        </div>

        <div class="clearfix">
          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            {{ profile_content | markdownify }}
          {% else %}
            {{ content }}
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </article>
</div>
